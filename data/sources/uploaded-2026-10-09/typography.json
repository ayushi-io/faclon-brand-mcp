{
  "families": { "heading": "TASA Orbiter", "body": "Inter" },
  "rule": "TASA Orbiter for headings only. Inter for body only. Never mix.",
  "display": {
    "xl": { "size": 72, "lineHeight": 80, "weight": "Bold", "tracking": "-2%" },
    "lg": { "size": 60, "lineHeight": 68, "weight": "Bold", "tracking": "-2%" },
    "md": { "size": 48, "lineHeight": 56, "weight": "Bold", "tracking": "-2%" }
  },
  "heading": {
    "h1": { "size": 40, "lineHeight": 48, "weight": "SemiBold" },
    "h2": { "size": 32, "lineHeight": 40, "weight": "SemiBold" },
    "h3": { "size": 24, "lineHeight": 32, "weight": "SemiBold" },
    "h4": { "size": 20, "lineHeight": 28, "weight": "SemiBold" },
    "h5": { "size": 18, "lineHeight": 24, "weight": "Medium" },
    "h6": { "size": 16, "lineHeight": 20, "weight": "Medium" },
    "tracking": "-1%"
  },
  "body": {
    "xl": { "size": 20, "lineHeight": 32 },
    "lg": { "size": 18, "lineHeight": 28 },
    "md": { "size": 16, "lineHeight": 24 },
    "sm": { "size": 14, "lineHeight": 22 },
    "xs": { "size": 12, "lineHeight": 18 },
    "2xs": { "size": 10, "lineHeight": 16 },
    "note": "10px is the floor. Inter Regular, no tracking."
  },
  "eyebrow": {
    "font": "Inter",
    "default": { "size": 10, "lineHeight": 16, "weight": "Medium", "tracking": "0.96px" },
    "altWeight": "SemiBold (12px, only permitted alternative)",
    "floor": { "size": 10, "weight": "Medium" },
    "transform": "uppercase"
  },
  "weightRange": { "min": 400, "max": 700, "banned": ["Thin", "ExtraLight", "Light", "ExtraBold", "Black"] },
  "responsiveBreakpoint": 768
}
